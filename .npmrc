# pnpm 11+ requires explicit approval for postinstall scripts. The same
# list is mirrored in pnpm-workspace.yaml for local dev; .npmrc is the
# copy Vercel's pnpm reads on the install step.
only-built-dependencies[]=@tailwindcss/oxide
only-built-dependencies[]=esbuild
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver

# Vercel-hosted builds: trust the lockfile but don't bail if the
# package.json#packageManager pin diverges from Vercel's bundled pnpm
# minor — corepack still installs the right version.
auto-install-peers=true
