# Base URL of the wispr-api service. Public — read by client-side fetch
# code, so it MUST start with NEXT_PUBLIC_. No trailing slash.
#
# Local dev:        http://localhost:8000   (wispr-api docker-compose default)
# Production:       /wispr-api   (same-origin path; Next rewrites it to the API)
#
# The rewrite target itself is set via WISPR_API_REWRITE_TARGET
# (defaults to https://wispr-api.rushyendra.dev). Raw WebSockets can't be
# rewritten, so they go direct to wss://wispr-api.rushyendra.dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
